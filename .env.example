# Copy this file to .env.local for local development, and add the same
# variables in Vercel under Project Settings -> Environment Variables
# for production. Never commit an actual .env.local file — it's already
# excluded in .gitignore.

# Follow Up Boss API key (Admin -> API in your FUB account).
# Optional: if unset, the contact form still works and just logs
# submissions server-side without creating a FUB lead.
FOLLOWUPBOSS_API_KEY=
